---
import Header from '../components/Header.astro';
import '../styles/global.css';
import { getCollection, type CollectionEntry } from 'astro:content';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleAdSense from '../components/GoogleAdSense.astro';
import devices from '../data/smartphones.json';

const allReviews = await getCollection('reviews');
// 한국어 원본 리뷰만 필터링 (en/, ja/ 제외)
const koReviews = allReviews.filter((r: CollectionEntry<'reviews'>) => !r.slug.includes('/'));
koReviews.sort((a, b) => new Date(b.data.date || '').getTime() - new Date(a.data.date || '').getTime());

const featuredPost = koReviews[0];
const trendingPosts = koReviews.slice(1, 3);

// 썸네일 및 비디오 정보를 포함한 피드 데이터 매핑
const feedPosts = koReviews.map((post: CollectionEntry<'reviews'>) => {
  const dev = devices.find((d: any) => d.id === post.slug);
  const vId = dev?.videos?.[0]?.youtube_id || 'TigCEb283aU';
  return {
    ...post,
    vId,
    devName: dev?.name_kr || dev?.name || post.data.device
  };
});

const categories = ['전체', '스마트폰/IT', '노트북/PC', '음향/웨어러블'];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TECH SPEC BLOG | 글로벌 테크 리뷰 & 스펙 백과 매거진</title>
  <meta name="description" content="글로벌 최신 IT 기기 심층 리뷰, 팩트 기반 평점(Verdict), 2020~2026 201종 스마트폰·태블릿·이북리더기·스마트워치 정밀 스펙 백과사전을 제공하는 전문 테크 매거진입니다." />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="TECH SPEC BLOG | 글로벌 테크 리뷰 & 스펙 백과 매거진" />
  <meta property="og:description" content="글로벌 최신 IT 기기 심층 리뷰, 팩트 기반 평점(Verdict), 2020~2026 201종 스마트폰·태블릿·이북리더기·스마트워치 정밀 스펙 백과사전을 제공하는 전문 테크 매거진입니다." />
  <meta property="og:url" content="https://tech-review-blog.vercel.app" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="TECH SPEC BLOG | 글로벌 테크 리뷰 & 스펙 백과 매거진" />
  <meta name="twitter:description" content="최신 IT 기기 심층 리뷰 & 스마트폰·스마트워치 스펙 백과사전" />

  <!-- Global i18n SEO Hreflang Tags -->
  <link rel="alternate" hreflang="ko" href="https://tech-review-blog.vercel.app/" />
  <link rel="alternate" hreflang="en" href="https://tech-review-blog.vercel.app/en" />
  <link rel="alternate" hreflang="ja" href="https://tech-review-blog.vercel.app/ja" />
  <link rel="alternate" hreflang="x-default" href="https://tech-review-blog.vercel.app/" />

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="google7dc3c11a8bcb6b9d" />
  <meta name="robots" content="index, follow" />
  <GoogleAnalytics />
  <GoogleAdSense />
</head>
<body>
  <Header />

  <main class="container" style="padding-top: 24px; padding-bottom: 80px;">
    <!-- Bento Grid Hero Section -->
    <section class="hero-banner" style="margin-bottom: 40px; text-align: center; padding: 48px 20px; background: linear-gradient(135deg, rgba(0, 242, 254, 0.08), rgba(79, 172, 254, 0.03)); border-radius: var(--radius-lg); border: 1px solid var(--border-color);">
      <span class="hero-badge-pill" style="display: inline-block; padding: 6px 16px; background: rgba(0, 242, 254, 0.12); color: var(--accent-cyan); border-radius: 20px; font-size: 0.85rem; font-weight: 700; margin-bottom: 16px; border: 1px solid rgba(0, 242, 254, 0.3);">
        ⚡ 팩트 기반 데이터 저널리즘 & 스펙 백과
      </span>
      <h1 class="hero-title" style="font-size: clamp(2rem, 3.8vw, 2.8rem); font-weight: 900; letter-spacing: -0.03em; margin-bottom: 16px; line-height: 1.2;">
        객관적 데이터. <span style="background: linear-gradient(90deg, #00f2fe, #4facfe); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">가식 없는 평점.</span>
      </h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 680px; margin: 0 auto 28px;">
        201종 스마트폰·태블릿·이북리더기·스마트워치 상세 스펙 비교와 실사용 벤치마크 기반 심층 리뷰.
      </p>
      <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
        <a href="/specs" style="padding: 12px 28px; background: linear-gradient(135deg, #00f2fe, #4facfe); color: #000; font-weight: 800; border-radius: var(--radius-sm); text-decoration: none;">
          📱 201종 스펙 백과사전 탐색
        </a>
        <a href="#reviews" style="padding: 12px 24px; background: var(--bg-card); color: var(--text-main); font-weight: 700; border-radius: var(--radius-sm); border: 1px solid var(--border-color); text-decoration: none;">
          최신 심층 리뷰 피드
        </a>
      </div>
    </section>

    <!-- Bento Grid Section with High-Res Video Thumbnails -->
    {featuredPost && (
      <section style="margin-bottom: 50px;">
        <div class="bento-hero-grid">
          <!-- Featured Large Card with Live Video Thumbnail -->
          <a href={`/reviews/${featuredPost.slug}`} class="bento-featured-card">
            <div class="bento-featured-media">
              <img 
                src={`https://img.youtube.com/vi/${devices.find((d: any) => d.id === featuredPost.slug)?.videos?.[0]?.youtube_id || 'TigCEb283aU'}/hqdefault.jpg`}
                alt={featuredPost.data.device}
              />
              <span class="bento-score-pill">
                ★ {featuredPost.data.score || '9.0'}
              </span>
              <span class="bento-cover-tag">⭐ FEATURED COVER</span>
            </div>
            <div class="bento-featured-content">
              <div class="bento-meta-row">
                <span class="bento-cat-badge">{featuredPost.data.category || '스마트폰/IT'}</span>
                <span class="bento-date">{featuredPost.data.date}</span>
              </div>
              <h2 class="bento-featured-title">{featuredPost.data.title}</h2>
              <p class="bento-featured-summary">{featuredPost.data.summary}</p>
              <div class="bento-featured-footer">
                <span class="bento-read-more">전체 심층 분석 읽기 ➔</span>
              </div>
            </div>
          </a>

          <!-- Trending Sidebar Cards with Live Video Thumbnails -->
          <div class="bento-trending-sidebar">
            {trendingPosts.map((post) => (
              <a href={`/reviews/${post.slug}`} class="bento-trending-card">
                <div class="bento-trending-media">
                  <img 
                    src={`https://img.youtube.com/vi/${devices.find((d: any) => d.id === post.slug)?.videos?.[0]?.youtube_id || 'Y9GIwUvWn3E'}/hqdefault.jpg`}
                    alt={post.data.device}
                  />
                  <span class="bento-trending-score">
                    ★ {post.data.score || '8.8'}
                  </span>
                </div>
                <div class="bento-trending-content">
                  <div class="bento-trending-badge-row">
                    <span class="bento-trending-tag">🔥 TRENDING</span>
                    <span class="bento-trending-date">{post.data.date}</span>
                  </div>
                  <h3 class="bento-trending-title">{post.data.title}</h3>
                  <p class="bento-trending-summary">{post.data.summary}</p>
                  <span class="bento-trending-link">리뷰 보기 ➔</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Category & Review Feed Grid with Video Thumbnails -->
    <section id="reviews" style="margin-bottom: 60px;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
          <h2 style="font-size: 1.8rem; font-weight: 800; color: #ffffff;">전체 심층 기기 리뷰</h2>
          <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">
            팩트 기반 스펙 시트와 핸즈온 장단점 분석이 수록된 공식 리뷰 목록입니다.
          </p>
        </div>
        <div style="color: var(--accent-cyan); font-weight: 700; font-size: 0.95rem;">
          총 {feedPosts.length}개 리뷰
        </div>
      </div>

      <div class="reviews-grid-feed">
        {feedPosts.map((post) => (
          <a href={`/reviews/${post.slug}`} class="feed-card">
            <!-- Live YouTube Video Thumbnail -->
            <div class="feed-card-media">
              <img 
                src={`https://img.youtube.com/vi/${post.vId}/hqdefault.jpg`} 
                alt={post.data.device} 
              />
              <span style="position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.85); color: var(--accent-cyan); padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.9rem; border: 1px solid rgba(0, 242, 254, 0.3);">
                ★ {post.data.score || '9.0'}
              </span>
              <span style="position: absolute; bottom: 10px; left: 10px; background: rgba(0,0,0,0.75); color: #fff; padding: 3px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600; backdrop-filter: blur(4px);">
                🎬 핸즈온 영상 포함
              </span>
            </div>
            
            <div class="feed-card-content">
              <span class="feed-card-category">
                {post.data.category || 'IT 기기'}
              </span>
              <h3 class="feed-card-title">
                {post.data.title}
              </h3>
              <p class="feed-card-summary">
                {post.data.summary}
              </p>
              <div class="feed-card-footer">
                <span>{post.data.date}</span>
                <span style="color: var(--accent-cyan); font-weight: 700;">전체 리뷰 보기 →</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer style="background: var(--bg-secondary); border-top: 1px solid var(--border-color); padding: 40px 0; text-align: center; color: var(--text-muted); font-size: 0.9rem;">
    <div class="container">
      <p>© 2026 TECH SPEC BLOG. 팩트 기반 테크 저널리즘 & 스펙 백과사전.</p>
    </div>
  </footer>
</body>
</html>
