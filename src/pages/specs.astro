---
import Header from '../components/Header.astro';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import devices from '../data/smartphones.json';

const totalCount = devices.length;
const phoneCount = devices.filter((d: any) => d.device_type === '스마트폰').length;
const tabletCount = devices.filter((d: any) => d.device_type === '태블릿').length;

const deviceTypes = ['전체', '스마트폰', '태블릿'];
const brands = ['전체', 'Samsung', 'Apple', 'Google', 'Xiaomi', 'Lenovo', 'iMuz', 'ALLDOCUBE', 'Oppo', 'Vivo', 'OnePlus', 'Huawei', 'Honor', '기타'];
const years = ['전체', '2026', '2025', '2024', '2023'];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>스마트폰 & 태블릿 스펙 & 실사용 비디오 백과사전 | TECH SPEC BLOG</title>
  <meta name="description" content="2023년부터 2026년 8월 현재까지 출시된 모든 스마트폰과 태블릿의 상세 스펙 명세표와 1:1 비교, 그리고 유튜브 실사용 핸즈온 리뷰 비디오 풀을 제공합니다." />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="스마트폰 & 태블릿 스펙 & 비디오 풀 백과사전 | TECH SPEC BLOG" />
  <meta property="og:description" content="134종 스마트폰·태블릿 정밀 사양표와 실제 유튜브 핸즈온 리뷰 영상 갤러리" />
  <meta property="og:url" content="https://tech-review-blog.vercel.app/specs" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="스마트폰 & 태블릿 스펙 & 비디오 풀 백과사전 | TECH SPEC BLOG" />
  <meta name="twitter:description" content="134종 스마트폰·태블릿 정밀 사양표와 실제 유튜브 핸즈온 리뷰 영상 갤러리" />

  <GoogleAnalytics />
</head>
<body>
  <Header />

  <section class="hero" style="padding: 48px 0 28px;">
    <div class="container">
      <div class="hero-badge">
        <span>🎬 2023 ~ 2026 스마트폰 & 태블릿 스펙 + 실사용 비디오 풀 통합</span>
      </div>
      <h1 style="font-size: clamp(2rem, 3.8vw, 2.8rem); margin-top: 8px;">
        스마트폰 & 태블릿 정밀 스펙 & 비디오 풀
      </h1>
      <p style="margin-top: 8px;">
        Galaxy Z Fold8 / 탭 S10 Ultra, iPad Pro M4, 샤오신패드 12.7, 뮤패드 K11, 올도큐브 iPlay 80까지<br />
        총 <strong>{totalCount}개 기기</strong>의 상세 명세표와 <strong>실제 유튜브 핸즈온 리뷰 영상</strong>을 한곳에서 시청하세요.
      </p>

      <!-- View Mode Switcher -->
      <div class="view-mode-toggle-wrapper">
        <div class="view-mode-toggle">
          <button class="view-mode-btn active" id="btnModeSpecs" data-mode="specs">
            <span>📊 스펙 명세표 모드</span>
          </button>
          <button class="view-mode-btn" id="btnModeVideos" data-mode="videos">
            <span>🎬 비디오 풀 갤러리</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <main class="container" style="padding-bottom: 100px;">
    <!-- Control & Filter Panel -->
    <div class="specs-control-panel">
      <!-- Search Input -->
      <div class="search-bar-wrapper">
        <span class="search-icon">🔍</span>
        <input 
          type="text" 
          id="specSearchInput" 
          class="search-input" 
          placeholder="기기명 (예: Galaxy Fold8, iPad M4, 샤오신패드, 뮤패드), 프로세서 (M4, 8 Elite, G99) 검색..." 
        />
      </div>

      <!-- Device Type Filter -->
      <div class="filter-group">
        <span class="filter-label">기기 종류 :</span>
        <div class="filter-chips" id="typeChips">
          {deviceTypes.map((type, idx) => (
            <button class={`chip-btn ${idx === 0 ? 'active' : ''}`} data-type={type}>
              {type === '전체' ? `전체 기기 (${totalCount})` : type === '스마트폰' ? `📱 스마트폰 (${phoneCount})` : `📟 태블릿 (${tabletCount})`}
            </button>
          ))}
        </div>
      </div>

      <!-- Brand Filter -->
      <div class="filter-group">
        <span class="filter-label">제조사 :</span>
        <div class="filter-chips" id="brandChips">
          {brands.map((brand, idx) => (
            <button class={`chip-btn ${idx === 0 ? 'active' : ''}`} data-brand={brand}>
              {brand === '전체' ? '전체 제조사' : brand === 'Samsung' ? '삼성 (Galaxy)' : brand === 'Apple' ? '애플 (Apple)' : brand === 'Lenovo' ? '레노버 (샤오신/리전)' : brand === 'iMuz' ? '아이뮤즈 (뮤패드)' : brand === 'ALLDOCUBE' ? '올도큐브 (iPlay)' : brand === 'Oppo' ? '오포 (OPPO)' : brand}
            </button>
          ))}
        </div>
      </div>

      <!-- Year Filter -->
      <div class="filter-group">
        <span class="filter-label">출시연도 :</span>
        <div class="filter-chips" id="yearChips">
          {years.map((year, idx) => (
            <button class={`chip-btn ${idx === 0 ? 'active' : ''}`} data-year={year}>
              {year === '전체' ? '전체 연도' : year === '2026' ? '2026년 (최신)' : `${year}년`}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Results Meta -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
      <div style="color: var(--text-muted); font-size: 0.95rem;">
        검색 및 필터 결과: <strong id="resultCount" style="color: var(--accent-cyan); font-size: 1.1rem;">{totalCount}</strong>개 항목
      </div>
      <div style="font-size: 0.85rem; color: var(--text-muted);" id="modeHint">
        * 기기를 2개 선택하여 <strong>1:1 스펙 맞비교</strong>를 할 수 있습니다.
      </div>
    </div>

    <!-- 1. Spec Cards Grid (Default Mode) -->
    <div class="grid" id="specCardsGrid">
      {devices.map((item: any) => (
        <div 
          class="spec-card" 
          data-id={item.id}
          data-type={item.device_type || '스마트폰'}
          data-brand={item.brand}
          data-year={item.release_year}
          data-name={`${item.name} ${item.name_kr} ${item.specs.ap} ${item.specs.camera} ${item.specs.display}`.toLowerCase()}
        >
          <div class="spec-card-header">
            <div>
              <span class="badge" style="margin-bottom: 8px;">
                {item.device_type === '태블릿' ? '📟 태블릿' : '📱 스마트폰'} • {item.brand_kr} • {item.release_date}
              </span>
              <h3 class="spec-card-title">{item.name}</h3>
              <div class="spec-card-sub">{item.name_kr}</div>
            </div>
            <span style="font-size: 0.8rem; padding: 4px 8px; border-radius: 6px; background: rgba(255,255,255,0.05); color: var(--text-muted);">
              {item.category}
            </span>
          </div>

          <div class="spec-summary-list">
            <div class="spec-summary-item">
              <span class="spec-summary-label">⚡ 프로세서</span>
              <span class="spec-summary-val">{item.specs.ap}</span>
            </div>
            <div class="spec-summary-item">
              <span class="spec-summary-label">🖥️ 화면</span>
              <span class="spec-summary-val">{item.specs.display}</span>
            </div>
            <div class="spec-summary-item">
              <span class="spec-summary-label">💾 메모리/용량</span>
              <span class="spec-summary-val">{item.specs.ram_storage}</span>
            </div>
            <div class="spec-summary-item">
              <span class="spec-summary-label">🔋 배터리</span>
              <span class="spec-summary-val">{item.specs.battery}</span>
            </div>
            <div class="spec-summary-item">
              <span class="spec-summary-label">💰 출고가</span>
              <span class="spec-summary-val" style="color: var(--accent-cyan); font-weight: 600;">{item.specs.price_krw}</span>
            </div>
          </div>

          <div class="spec-card-actions">
            <button class="btn-detail" data-action="detail" data-id={item.id}>
              📖 스펙 & 🎬 영상
            </button>
            <button class="btn-compare-check" data-action="compare-toggle" data-id={item.id}>
              + 비교함
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- 2. Video Pool Grid (Videos Mode) -->
    <div class="video-pool-grid" id="videoCardsGrid" style="display: none;">
      {devices.map((item: any) => {
        const firstVid = item.videos && item.videos.length > 0 ? item.videos[0] : null;
        if (!firstVid) return null;
        return (
          <div 
            class="video-card"
            data-id={item.id}
            data-vid={firstVid.youtube_id}
            data-title={firstVid.title}
            data-type={item.device_type || '스마트폰'}
            data-brand={item.brand}
            data-year={item.release_year}
            data-name={`${item.name} ${item.name_kr} ${firstVid.title} ${firstVid.channel}`.toLowerCase()}
          >
            <div class="video-thumb-container">
              <img 
                src={firstVid.thumbnail} 
                alt={firstVid.title} 
                class="video-thumb-img" 
                onerror={`this.onerror=null; this.src='https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=800&auto=format&fit=crop&q=80';`}
                loading="lazy"
              />
              <div class="video-play-overlay">
                <div class="video-play-icon">▶</div>
              </div>
              <span class="video-duration-badge">{firstVid.duration || '12:00'}</span>
            </div>
            <div class="video-card-body">
              <div class="video-device-tag">
                {item.device_type === '태블릿' ? '📟 태블릿' : '📱 스마트폰'} • {item.name}
              </div>
              <h4 class="video-card-title">{firstVid.title}</h4>
              <div class="video-card-meta">
                <span>👤 {firstVid.channel}</span>
                <span>{item.release_date}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </main>

  <!-- 1:1 Compare Floating Bottom Bar -->
  <div class="compare-floating-bar" id="compareFloatingBar">
    <div style="display: flex; align-items: center; gap: 8px;">
      <span class="compare-badge-pill">⚖️ 비교함</span>
      <span id="compareSelectedText" style="font-size: 0.9rem; color: #ffffff;">0 / 2 기기 선택됨</span>
    </div>
    <button class="btn-launch-compare" id="btnOpenCompare">
      1:1 스펙 비교하기 ➔
    </button>
  </div>

  <!-- Detail Spec Modal (With Videos Section) -->
  <div class="modal-overlay" id="detailModal">
    <div class="modal-content">
      <button class="modal-close-btn" id="closeDetailModal">✕</button>
      <div id="detailModalBody">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </div>

  <!-- 1:1 Comparison Modal -->
  <div class="modal-overlay" id="compareModal">
    <div class="modal-content" style="max-width: 1000px;">
      <button class="modal-close-btn" id="closeCompareModal">✕</button>
      <h2 style="font-size: 1.6rem; color: #ffffff; margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
        <span>⚖️ 1:1 기기 정밀 스펙 맞비교</span>
      </h2>
      <div id="compareModalBody">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </div>

  <!-- YouTube Video Player Modal (Facade Player) -->
  <div class="modal-overlay" id="videoPlayerModal">
    <div class="modal-content" style="max-width: 860px; padding: 20px;">
      <button class="modal-close-btn" id="closeVideoPlayerModal">✕</button>
      <h3 id="videoModalTitle" style="font-size: 1.25rem; color: #ffffff; margin: 6px 0 12px; padding-right: 36px; line-height: 1.4;">
        <!-- Injected via JS -->
      </h3>
      <div class="video-player-frame-wrapper" id="videoFrameContainer">
        <!-- Dynamic iframe injected on play -->
      </div>
    </div>
  </div>

  <footer>
    <div class="container">
      <div style="margin-bottom: 12px; display: flex; justify-content: center; gap: 20px; font-size: 0.9rem;">
        <a href="/about" style="color: var(--text-muted); text-decoration: none;">블로그 소개</a>
        <a href="/privacy" style="color: var(--text-muted); text-decoration: none;">개인정보처리방침</a>
        <a href="/contact" style="color: var(--text-muted); text-decoration: none;">문의하기</a>
      </div>
      <p>© 2026 Tech Review Blog. 2023-2026 Smartphone & Tablet Spec & Video Pool.</p>
    </div>
  </footer>

  <Analytics />

  <!-- Client Interaction Logic -->
  <script is:inline define:vars={{ rawData: devices }}>
    const allData = rawData;
    let currentMode = 'specs'; // 'specs' or 'videos'
    let selectedType = '전체';
    let selectedBrand = '전체';
    let selectedYear = '전체';
    let searchQuery = '';
    const selectedForCompare = new Set();

    // DOM Elements
    const searchInput = document.getElementById('specSearchInput');
    const typeChips = document.querySelectorAll('#typeChips .chip-btn');
    const brandChips = document.querySelectorAll('#brandChips .chip-btn');
    const yearChips = document.querySelectorAll('#yearChips .chip-btn');
    const resultCount = document.getElementById('resultCount');
    const modeHint = document.getElementById('modeHint');

    const btnModeSpecs = document.getElementById('btnModeSpecs');
    const btnModeVideos = document.getElementById('btnModeVideos');
    const specCardsGrid = document.getElementById('specCardsGrid');
    const videoCardsGrid = document.getElementById('videoCardsGrid');

    const compareFloatingBar = document.getElementById('compareFloatingBar');
    const compareSelectedText = document.getElementById('compareSelectedText');
    const btnOpenCompare = document.getElementById('btnOpenCompare');

    const detailModal = document.getElementById('detailModal');
    const detailModalBody = document.getElementById('detailModalBody');
    const closeDetailModal = document.getElementById('closeDetailModal');

    const compareModal = document.getElementById('compareModal');
    const compareModalBody = document.getElementById('compareModalBody');
    const closeCompareModal = document.getElementById('closeCompareModal');

    const videoPlayerModal = document.getElementById('videoPlayerModal');
    const videoModalTitle = document.getElementById('videoModalTitle');
    const videoFrameContainer = document.getElementById('videoFrameContainer');
    const closeVideoPlayerModal = document.getElementById('closeVideoPlayerModal');

    // Switch View Mode
    btnModeSpecs.addEventListener('click', () => {
      currentMode = 'specs';
      btnModeSpecs.classList.add('active');
      btnModeVideos.classList.remove('active');
      specCardsGrid.style.display = 'grid';
      videoCardsGrid.style.display = 'none';
      modeHint.innerHTML = '* 기기를 2개 선택하여 <strong>1:1 스펙 맞비교</strong>를 할 수 있습니다.';
      applyFilters();
    });

    btnModeVideos.addEventListener('click', () => {
      currentMode = 'videos';
      btnModeVideos.classList.add('active');
      btnModeSpecs.classList.remove('active');
      specCardsGrid.style.display = 'none';
      videoCardsGrid.style.display = 'grid';
      modeHint.innerHTML = '* 썸네일을 클릭하면 <strong>실사용 유튜브 영상</strong>이 즉시 재생됩니다.';
      applyFilters();
    });

    // Filter Function
    function applyFilters() {
      const targetCards = currentMode === 'specs' 
        ? document.querySelectorAll('#specCardsGrid .spec-card')
        : document.querySelectorAll('#videoCardsGrid .video-card');

      let visibleCount = 0;
      targetCards.forEach(card => {
        const type = card.getAttribute('data-type');
        const brand = card.getAttribute('data-brand');
        const year = card.getAttribute('data-year');
        const nameData = card.getAttribute('data-name') || '';

        const matchType = (selectedType === '전체' || type === selectedType);

        let matchBrand = false;
        if (selectedBrand === '전체') {
          matchBrand = true;
        } else if (selectedBrand === '기타') {
          matchBrand = !['Samsung', 'Apple', 'Google', 'Xiaomi', 'Lenovo', 'iMuz', 'ALLDOCUBE', 'Oppo', 'Vivo', 'OnePlus', 'Huawei', 'Honor'].includes(brand);
        } else {
          matchBrand = (brand === selectedBrand);
        }

        const matchYear = (selectedYear === '전체' || year === selectedYear);
        const matchSearch = (!searchQuery || nameData.includes(searchQuery.toLowerCase()));

        if (matchType && matchBrand && matchYear && matchSearch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      resultCount.innerText = visibleCount;
    }

    // Event Listeners for Filters
    searchInput.addEventListener('input', (e) => {
      searchQuery = e.target.value.trim();
      applyFilters();
    });

    typeChips.forEach(btn => {
      btn.addEventListener('click', () => {
        typeChips.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedType = btn.getAttribute('data-type');
        applyFilters();
      });
    });

    brandChips.forEach(btn => {
      btn.addEventListener('click', () => {
        brandChips.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedBrand = btn.getAttribute('data-brand');
        applyFilters();
      });
    });

    yearChips.forEach(btn => {
      btn.addEventListener('click', () => {
        yearChips.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        selectedYear = btn.getAttribute('data-year');
        applyFilters();
      });
    });

    // Delegate Click for Spec Cards
    specCardsGrid.addEventListener('click', (e) => {
      const detailBtn = e.target.closest('[data-action="detail"]');
      const compareBtn = e.target.closest('[data-action="compare-toggle"]');

      if (detailBtn) {
        const id = detailBtn.getAttribute('data-id');
        openDetail(id);
      } else if (compareBtn) {
        const id = compareBtn.getAttribute('data-id');
        toggleCompare(id, compareBtn);
      }
    });

    // Delegate Click for Video Cards (Direct Play)
    videoCardsGrid.addEventListener('click', (e) => {
      const card = e.target.closest('.video-card');
      if (card) {
        const vid = card.getAttribute('data-vid');
        const title = card.getAttribute('data-title');
        playYouTubeVideo(vid, title);
      }
    });

    // YouTube Facade Player Opener
    function playYouTubeVideo(youtubeId, title) {
      videoModalTitle.innerText = title;
      const searchUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(title)}`;
      const directWatchUrl = youtubeId ? `https://www.youtube.com/watch?v=${youtubeId}` : searchUrl;

      // Inject iframe with enhanced embed fallback
      videoFrameContainer.innerHTML = `
        <div style="margin-bottom: 12px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; background: rgba(220,38,38,0.15); border: 1px solid rgba(220,38,38,0.4); padding: 10px 14px; border-radius: 6px;">
          <span style="font-size: 0.85rem; color: #fca5a5;">
            🎬 외부 임베드 제한 시 원클릭으로 YouTube에서 이 영상을 고화질로 바로 시청하세요:
          </span>
          <a href="${directWatchUrl}" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 6px; background: #dc2626; color: #ffffff; padding: 7px 16px; border-radius: 4px; font-size: 0.85rem; font-weight: 700; text-decoration: none; box-shadow: 0 2px 8px rgba(220,38,38,0.4);">
            ▶ YouTube에서 원본 영상 바로보기 ➔
          </a>
        </div>
        <div style="position: relative; width: 100%; aspect-ratio: 16/9; background: #000; border-radius: 8px; overflow: hidden;">
          <iframe 
            src="https://www.youtube.com/embed/${youtubeId}?autoplay=1&playsinline=1&rel=0&enablejsapi=1" 
            title="${title}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
          ></iframe>
        </div>
        <div style="margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.1);">
          <span style="font-size: 0.82rem; color: var(--text-muted);">
            📺 기기별 핸즈온 & 벤치마크 영상 풀
          </span>
          <div style="display: flex; gap: 8px;">
            <a href="${directWatchUrl}" target="_blank" rel="noopener noreferrer" style="background: #dc2626; color: #ffffff; padding: 6px 14px; border-radius: 4px; font-size: 0.82rem; font-weight: 700; text-decoration: none;">
              ▶ 원본 영상 직접 시청
            </a>
            <a href="${searchUrl}" target="_blank" rel="noopener noreferrer" style="background: rgba(255,255,255,0.1); color: #e2e8f0; padding: 6px 14px; border-radius: 4px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(255,255,255,0.2);">
              🔍 관련 리뷰 더보기
            </a>
          </div>
        </div>
      `;
      videoPlayerModal.classList.add('open');
    }

    // Stop and cleanup video on close
    function closeVideoPlayer() {
      videoFrameContainer.innerHTML = '';
      videoPlayerModal.classList.remove('open');
    }

    closeVideoPlayerModal.addEventListener('click', closeVideoPlayer);

    // Open Detail Spec Modal (With Video Thumbnails Section)
    function openDetail(id) {
      const item = allData.find(d => d.id === id);
      if (!item) return;

      const videosHtml = (item.videos && item.videos.length > 0) ? `
        <div class="detail-video-box">
          <div class="detail-video-title">
            <span>🎬 실제 핸즈온 & 리뷰 영상 (${item.videos.length}개)</span>
          </div>
          <div class="detail-video-grid">
            ${item.videos.map(v => `
              <div class="detail-video-item" data-vid="${v.youtube_id}" data-title="${v.title}">
                <div class="video-thumb-container">
                  <img src="${v.thumbnail}" alt="${v.title}" class="video-thumb-img" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=800&auto=format&fit=crop&q=80';" loading="lazy" />
                  <div class="video-play-overlay">
                    <div class="video-play-icon" style="width: 40px; height: 40px; font-size: 1.1rem;">▶</div>
                  </div>
                  <span class="video-duration-badge">${v.duration || '12:00'}</span>
                </div>
                <div style="padding: 10px;">
                  <div style="font-size: 0.88rem; font-weight: 700; color: #ffffff; line-height: 1.3; margin-bottom: 4px;">
                    ${v.title}
                  </div>
                  <div style="font-size: 0.78rem; color: var(--text-muted);">
                    👤 ${v.channel}
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      ` : '';

      detailModalBody.innerHTML = `
        <div style="margin-bottom: 24px;">
          <span class="badge">${item.device_type === '태블릿' ? '📟 태블릿' : '📱 스마트폰'} • ${item.brand_kr} • ${item.release_date}</span>
          <h2 style="font-size: 1.8rem; color: #ffffff; margin: 8px 0;">${item.name} (${item.name_kr})</h2>
          <p style="color: var(--text-muted); font-size: 0.95rem;">분류: ${item.category} • 공식 출시 가격: <strong style="color: var(--accent-cyan);">${item.specs.price_krw}</strong></p>
        </div>

        <table style="width: 100%; border-collapse: collapse; margin-top: 16px;">
          <tbody>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan); width: 25%;">⚡ 프로세서 (AP/칩셋)</td>
              <td style="padding: 12px; color: #f1f5f9;">${item.specs.ap}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">🖥️ 디스플레이</td>
              <td style="padding: 12px; color: #f1f5f9;">${item.specs.display}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">💾 메모리 & 스토리지</td>
              <td style="padding: 12px; color: #f1f5f9;">${item.specs.ram_storage}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">📷 카메라 시스템</td>
              <td style="padding: 12px; color: #f1f5f9;">${item.specs.camera}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">🔋 배터리 & 충전</td>
              <td style="padding: 12px; color: #f1f5f9;">${item.specs.battery}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">📐 규격 & 무게</td>
              <td style="padding: 12px; color: #f1f5f9;">${item.specs.dimensions_weight}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">🛡️ OS & 특징</td>
              <td style="padding: 12px; color: #f1f5f9;">${item.specs.os_durability}</td>
            </tr>
            <tr>
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">💰 출시 가격</td>
              <td style="padding: 12px; color: #f1f5f9; font-weight: 700;">${item.specs.price_krw}</td>
            </tr>
          </tbody>
        </table>

        ${videosHtml}
      `;

      // Attach click to detail video items
      detailModalBody.querySelectorAll('.detail-video-item').forEach(el => {
        el.addEventListener('click', () => {
          const vid = el.getAttribute('data-vid');
          const title = el.getAttribute('data-title');
          playYouTubeVideo(vid, title);
        });
      });

      detailModal.classList.add('open');
    }

    // Toggle Compare Selection
    function toggleCompare(id, btn) {
      if (selectedForCompare.has(id)) {
        selectedForCompare.delete(id);
        btn.classList.remove('checked');
        btn.innerText = '+ 비교함';
      } else {
        if (selectedForCompare.size >= 2) {
          alert('비교는 한 번에 최대 2대까지 가능합니다. 기존 기기를 취소 후 선택해 주세요.');
          return;
        }
        selectedForCompare.add(id);
        btn.classList.add('checked');
        btn.innerText = '✓ 선택됨';
      }

      updateCompareBar();
    }

    function updateCompareBar() {
      const count = selectedForCompare.size;
      compareSelectedText.innerText = `${count} / 2 기기 선택됨`;

      if (count > 0) {
        compareFloatingBar.classList.add('show');
      } else {
        compareFloatingBar.classList.remove('show');
      }
    }

    // Open Compare Modal
    btnOpenCompare.addEventListener('click', () => {
      if (selectedForCompare.size < 2) {
        alert('스펙을 비교하려면 2개의 기기를 선택해 주세요.');
        return;
      }

      const ids = Array.from(selectedForCompare);
      const itemA = allData.find(d => d.id === ids[0]);
      const itemB = allData.find(d => d.id === ids[1]);

      if (!itemA || !itemB) return;

      compareModalBody.innerHTML = `
        <table style="width: 100%; border-collapse: collapse; margin-top: 10px;">
          <thead>
            <tr style="background: rgba(0, 242, 254, 0.15); border-bottom: 2px solid var(--accent-cyan);">
              <th style="padding: 14px; text-align: left; color: var(--accent-cyan); width: 22%;">스펙 비교 항목</th>
              <th style="padding: 14px; text-align: left; color: #ffffff; width: 39%; font-size: 1.1rem;">
                <div>${itemA.name}</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">${itemA.device_type || ''} • ${itemA.brand_kr} • ${itemA.release_date}</div>
              </th>
              <th style="padding: 14px; text-align: left; color: #ffffff; width: 39%; font-size: 1.1rem;">
                <div>${itemB.name}</div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">${itemB.device_type || ''} • ${itemB.brand_kr} • ${itemB.release_date}</div>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">⚡ 프로세서 (AP/칩셋)</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemA.specs.ap}</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemB.specs.ap}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">🖥️ 디스플레이</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemA.specs.display}</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemB.specs.display}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">💾 메모리 & 용량</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemA.specs.ram_storage}</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemB.specs.ram_storage}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">📷 카메라 시스템</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemA.specs.camera}</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemB.specs.camera}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">🔋 배터리 & 충전</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemA.specs.battery}</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemB.specs.battery}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">📐 규격 & 무게</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemA.specs.dimensions_weight}</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemB.specs.dimensions_weight}</td>
            </tr>
            <tr style="border-bottom: 1px solid rgba(255,255,255,0.08);">
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">🛡️ OS & 특징</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemA.specs.os_durability}</td>
              <td style="padding: 12px; color: #f1f5f9;">${itemB.specs.os_durability}</td>
            </tr>
            <tr>
              <td style="padding: 12px; font-weight: 700; color: var(--accent-cyan);">💰 출시 가격</td>
              <td style="padding: 12px; color: var(--accent-cyan); font-weight: 700;">${itemA.specs.price_krw}</td>
              <td style="padding: 12px; color: var(--accent-cyan); font-weight: 700;">${itemB.specs.price_krw}</td>
            </tr>
          </tbody>
        </table>
      `;

      compareModal.classList.add('open');
    });

    // Close Modals
    closeDetailModal.addEventListener('click', () => detailModal.classList.remove('open'));
    closeCompareModal.addEventListener('click', () => compareModal.classList.remove('open'));

    window.addEventListener('click', (e) => {
      if (e.target === detailModal) detailModal.classList.remove('open');
      if (e.target === compareModal) compareModal.classList.remove('open');
      if (e.target === videoPlayerModal) closeVideoPlayer();
    });
  </script>
</body>
</html>
