---
import Header from '../../components/Header.astro';
import '../../styles/global.css';
import { getCollection, type CollectionEntry } from 'astro:content';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';
import GoogleAdSense from '../../components/GoogleAdSense.astro';
import devices from '../../data/smartphones.json';
import { sortReviewsByDeviceRelease } from '../../utils/sorting';

const allReviews = await getCollection('reviews');
const rawEnReviews = allReviews.filter((r: CollectionEntry<'reviews'>) => r.slug.startsWith('en/'));
const enReviews = sortReviewsByDeviceRelease(rawEnReviews);

const featuredPost = enReviews[0];
const trendingPosts = enReviews.slice(1, 3);

// 썸네일 및 비디오 정보를 포함한 피드 데이터 매핑
const feedPosts = enReviews.map((post: CollectionEntry<'reviews'>) => {
  const pureSlug = post.slug.replace('en/', '');
  const dev = devices.find((d: any) => d.id === pureSlug);
  const vId = dev?.videos?.[0]?.youtube_id || 'TigCEb283aU';
  const devImage = (dev as any)?.image || `/images/devices/${pureSlug}.webp`;
  return {
    ...post,
    pureSlug,
    vId,
    devImage,
    devName: dev?.name || post.data.device
  };
});

const trendingPostsMapped = trendingPosts.map((post: CollectionEntry<'reviews'>) => {
  const pureSlug = post.slug.replace('en/', '');
  const dev = devices.find((d: any) => d.id === pureSlug);
  const img = (dev as any)?.image || `/images/devices/${pureSlug}.webp`;
  return {
    ...post,
    pureSlug,
    img
  };
});

const featuredDev = devices.find((d: any) => d.id === featuredPost.slug.replace('en/', ''));
const featuredImage = (featuredDev as any)?.image || `/images/devices/${featuredPost.slug.replace('en/', '')}.webp`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TECH SPEC BLOG | Global Tech In-Depth Reviews & Spec Encyclopedia</title>
  <meta name="description" content="Global tech reviews, fact-driven Verge-style verdicts, and comprehensive specifications database for latest flagship devices." />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="TECH SPEC BLOG | Global Tech Reviews & Spec Encyclopedia" />
  <meta property="og:description" content="Global tech reviews, fact-driven Verge-style verdicts, and comprehensive specifications database for latest flagship devices." />
  <meta property="og:url" content="https://tech.thesinoreport.com/en" />

  <!-- Global i18n SEO Hreflang Tags -->
  <link rel="alternate" hreflang="ko" href="https://tech.thesinoreport.com/" />
  <link rel="alternate" hreflang="en" href="https://tech.thesinoreport.com/en" />
  <link rel="alternate" hreflang="ja" href="https://tech.thesinoreport.com/ja" />
  <link rel="alternate" hreflang="x-default" href="https://tech.thesinoreport.com/" />

  <GoogleAnalytics />
  <GoogleAdSense />
</head>
<body>
  <Header />

  <main class="container" style="padding-top: 24px; padding-bottom: 80px;">
    <!-- Hero Banner -->
    <section class="hero-banner" style="margin-bottom: 40px; text-align: center; padding: 48px 20px;">
      <span class="hero-badge-pill">
        ⚡ Latest Flagship Devices Fact-Checked Database
      </span>
      <h1 class="hero-title" style="font-size: clamp(2rem, 3.8vw, 2.8rem); font-weight: 900; margin-bottom: 16px;">
        Objective Data. <span style="background: linear-gradient(90deg, #00f2fe, #4facfe); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Unbiased Verdicts.</span>
      </h1>
      <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 680px; margin: 0 auto 28px;">
        Explore verified smartphone, tablet & wearable specifications and real-world benchmark reviews.
      </p>
      <div style="display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;">
        <a href="/specs" style="padding: 12px 28px; background: linear-gradient(135deg, #00f2fe, #4facfe); color: #000; font-weight: 800; border-radius: var(--radius-sm); text-decoration: none;">
          📱 Explore Spec Database
        </a>
        <a href="#reviews" style="padding: 12px 24px; background: var(--bg-card); color: var(--text-main); font-weight: 700; border-radius: var(--radius-sm); border: 1px solid var(--border-color); text-decoration: none;">
          Latest Reviews
        </a>
      </div>
    </section>

    <!-- Bento Grid Section with Official Device Photos -->
    {featuredPost && (
      <section style="margin-bottom: 50px;">
        <div class="bento-hero-grid">
          <!-- Featured Large Card -->
          <a href={`/en/reviews/${featuredPost.slug.replace('en/', '')}`} class="bento-featured-card">
            <div class="bento-featured-media">
              <img 
                src={featuredImage}
                alt={featuredPost.data.device}
                onerror="this.onerror=null; this.src='/images/devices/category-default.jpg';"
                loading="eager"
              />
              <span class="bento-score-pill">
                ★ {featuredPost.data.score}
              </span>
              <span class="bento-cover-tag">⭐ FEATURED COVER</span>
            </div>
            <div class="bento-featured-content">
              <div class="bento-meta-row">
                <span class="bento-cat-badge">{featuredPost.data.category || 'Tech'}</span>
                <span class="bento-date">{featuredPost.data.date}</span>
              </div>
              <h2 class="bento-featured-title">{featuredPost.data.title}</h2>
              <p class="bento-featured-summary">{featuredPost.data.summary}</p>
              <div class="bento-featured-footer">
                <span class="bento-read-more">Read Full In-Depth Review ➔</span>
              </div>
            </div>
          </a>

          <!-- Trending Sidebar Cards with Official Photos -->
          <div class="bento-trending-sidebar">
            {trendingPostsMapped.map((post: any) => (
              <a href={`/en/reviews/${post.pureSlug}`} class="bento-trending-card">
                <div class="bento-trending-media">
                  <img 
                    src={post.img}
                    alt={post.data.device}
                    onerror="this.onerror=null; this.src='/images/devices/category-default.jpg';"
                    loading="lazy"
                  />
                  <span class="bento-trending-score">
                    ★ {post.data.score}
                  </span>
                </div>
                <div class="bento-trending-content">
                  <div class="bento-trending-badge-row">
                    <span class="bento-trending-tag">🔥 TRENDING</span>
                    <span class="bento-trending-date">{post.data.date}</span>
                  </div>
                  <h3 class="bento-trending-title">{post.data.title}</h3>
                  <p class="bento-trending-summary">{post.data.summary}</p>
                  <span class="bento-trending-link">Read Review ➔</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Reviews Grid with Official Photos -->
    <section id="reviews" style="margin-bottom: 60px;">
      <h2 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 24px; color: var(--text-main);">All In-Depth Reviews</h2>
      <div class="reviews-grid-feed">
        {feedPosts.map((post: any) => (
          <a href={`/en/reviews/${post.pureSlug}`} class="feed-card">
            <div class="feed-card-media">
              <img src={post.devImage} alt={post.data.device} onerror="this.onerror=null; this.src='/images/devices/category-default.jpg';" loading="lazy" />
              <span style="position: absolute; top: 12px; right: 12px; background: rgba(0,0,0,0.85); color: var(--accent-cyan); padding: 4px 10px; border-radius: 6px; font-weight: 800; font-size: 0.9rem;">
                ★ {post.data.score}
              </span>
            </div>
            <div class="feed-card-content">
              <span class="feed-card-category">{post.data.category || 'Tech'}</span>
              <h3 class="feed-card-title">{post.data.title}</h3>
              <p class="feed-card-summary">{post.data.summary}</p>
              <div class="feed-card-footer">
                <span style="font-weight: 700; color: var(--text-main);">{post.devName}</span>
                <span class="read-more-link" style="color: var(--accent-cyan); font-weight: 700;">View Review ➔</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer style="background: var(--bg-secondary); border-top: 1px solid var(--border-color); padding: 40px 0; text-align: center; color: var(--text-muted); font-size: 0.9rem;">
    <div class="container">
      <p>© 2026 TECH SPEC BLOG. Independent Tech Journalism & Hardware Database.</p>
    </div>
  </footer>
</body>
</html>
