---
import Header from '../components/Header.astro';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const { frontmatter } = Astro.props;

const allReviews = await getCollection('reviews');
const recentReviews = allReviews
  .filter((r: CollectionEntry<'reviews'>) => r.data.device !== frontmatter.device)
  .slice(0, 4);

const jsonLd = {
  "@context": "https://schema.org/",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Product",
    "name": frontmatter.device || frontmatter.title
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": String(frontmatter.score || 9.0),
    "bestRating": "10"
  },
  "author": {
    "@type": "Organization",
    "name": "Tech Review Blog"
  }
};
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter.title} | TECH SPEC BLOG</title>
  <meta name="description" content={frontmatter.summary} />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={`${frontmatter.title} | TECH SPEC BLOG`} />
  <meta property="og:description" content={frontmatter.summary} />
  <meta property="og:url" content={Astro.url.href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${frontmatter.title} | TECH SPEC BLOG`} />
  <meta name="twitter:description" content={frontmatter.summary} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <GoogleAnalytics />
</head>
<body>
  <Header />

  <main class="container" style="padding-top: 36px; padding-bottom: 80px;">
    <div class="review-layout-grid">
      <!-- Main Content (Left Column) -->
      <article class="review-article">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
          <span class="badge">{frontmatter.category || '스마트폰/IT'}</span>
          {frontmatter.score >= 9.0 && (
            <span class="badge badge-gold">⭐ EDITORS CHOICE</span>
          )}
        </div>

        <h1>{frontmatter.title}</h1>
        
        <div class="review-meta">
          <span>📅 {frontmatter.date}</span>
          <span>•</span>
          <span>기기명: <strong style="color: #ffffff;">{frontmatter.device}</strong></span>
          <span>•</span>
          <span>⏱️ 약 3분 읽기</span>
        </div>

        <!-- The Verge Style 'The Verdict' Box -->
        <div class="verdict-box">
          <div class="verdict-header">
            <div>
              <div style="font-size: 0.82rem; color: var(--accent-cyan); font-weight: 800; letter-spacing: 1px; text-transform: uppercase;">
                EDITORIAL VERDICT
              </div>
              <h3 class="verdict-title">
                {frontmatter.device} 에디터 최종 평결
              </h3>
            </div>
            <div class="verdict-score-display">
              <span class="verdict-score-num">{frontmatter.score || '9.0'}</span>
              <span class="verdict-score-total">/ 10</span>
            </div>
          </div>

          <div style="font-size: 0.95rem; color: #cbd5e1; line-height: 1.6; background: rgba(10, 14, 22, 0.5); padding: 14px 18px; border-radius: var(--radius-sm); border-left: 3px solid var(--accent-cyan); margin-bottom: 18px;">
            <strong style="color: var(--accent-cyan);">💡 The Bottom Line :</strong> {frontmatter.summary}
          </div>

          <div class="verdict-columns">
            <div class="verdict-col verdict-good">
              <h4>👍 The Good (주요 장점)</h4>
              <ul class="verdict-list">
                {frontmatter.pros && frontmatter.pros.map((pro: string) => (
                  <li>
                    <span style="color: #86efac; font-weight: bold;">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="verdict-col verdict-bad">
              <h4>👎 The Bad (아쉬운 점)</h4>
              <ul class="verdict-list">
                {frontmatter.cons && frontmatter.cons.map((con: string) => (
                  <li>
                    <span style="color: #fca5a5; font-weight: bold;">✕</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Markdown Article Body with Specs and Benchmarks -->
        <slot />
      </article>

      <!-- Sticky Sidebar (Right Column for Desktop) -->
      <aside class="sidebar">
        <!-- Score Card Widget -->
        <div class="sidebar-card">
          <div class="sidebar-title">
            <span>📊 스펙 & 평점 대시보드</span>
          </div>
          <div class="score-badge-large">
            <div>
              <div style="font-size: 0.85rem; color: var(--text-muted);">종합 평점 (10점 만점)</div>
              <div style="font-size: 1.15rem; font-weight: 800; color: #ffffff;">{frontmatter.device}</div>
            </div>
            <div class="score-num">{frontmatter.score}</div>
          </div>

          <a href="/specs" class="btn-detail" style="display: block; text-align: center; text-decoration: none; margin-bottom: 12px; padding: 10px;">
            📚 전체 스펙 백과에서 비교하기 ➔
          </a>
        </div>

        <!-- Share Widget -->
        <div class="sidebar-card">
          <div class="sidebar-title">
            <span>🔗 리뷰 공유하기</span>
          </div>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 16px;">
            이 기기 분석이 유용하셨다면 링크를 복사하여 공유해 보세요.
          </p>
          <button class="share-btn" id="copyUrlBtn">
            📋 현재 글 링크 복사
          </button>
        </div>

        <!-- Recent Reviews Widget -->
        {recentReviews.length > 0 && (
          <div class="sidebar-card">
            <div class="sidebar-title">
              <span>🔥 다른 최신 리뷰</span>
            </div>
            <div>
              {recentReviews.map((post: CollectionEntry<'reviews'>) => (
                <div class="recent-review-item">
                  <a href={`/reviews/${post.slug}`}>
                    {post.data.title}
                  </a>
                  <div class="recent-review-meta">
                    <span>{post.data.category || '테크'}</span>
                    <span style="color: var(--accent-cyan); font-weight: 700;">⭐ {post.data.score}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </main>

  <footer>
    <div class="container">
      <p>© 2026 Tech Review Blog. Automated AI Data Synthesis Pipeline & Spec Database.</p>
    </div>
  </footer>

  <Analytics />

  <script is:inline>
    const btn = document.getElementById('copyUrlBtn');
    if (btn) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const originalText = btn.innerText;
          btn.innerText = '✅ 링크 복사 완료!';
          setTimeout(() => {
            btn.innerText = originalText;
          }, 2000);
        });
      });
    }
  </script>
</body>
</html>
