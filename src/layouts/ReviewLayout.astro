---
import Header from '../components/Header.astro';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import GoogleAdSense from '../components/GoogleAdSense.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import devicesData from '../data/devices.json';

const { frontmatter, slug, lang = 'ko' } = Astro.props;

const siteUrl = 'https://tech.thesinoreport.com';
const koUrl = `${siteUrl}/reviews/${slug}`;
const enUrl = `${siteUrl}/en/reviews/${slug}`;
const jaUrl = `${siteUrl}/ja/reviews/${slug}`;

const allReviews = await getCollection('reviews');
const recentReviews = allReviews
  .filter((r: CollectionEntry<'reviews'>) => r.slug !== slug && r.data.device !== frontmatter.device)
  .slice(0, 4);

// 1. Direct 100% exact match by slug
let matchedDevice = slug ? devicesData.find(d => d.id === slug) : null;

// 2. Robust normalized name matching fallback
if (!matchedDevice) {
  const normalize = (str?: string) => (str || '').toLowerCase().replace(/[^a-z0-9가-힣]/g, '');
  const target = normalize(frontmatter.device || '');
  
  matchedDevice = devicesData.find(d => {
    const dId = normalize(d.id);
    const dName = normalize(d.name);
    const dKr = normalize(d.name_kr);
    return dId === target || dName.includes(target) || dKr.includes(target) || target.includes(dName) || target.includes(dKr);
  });
}

// 3. Fallback device object if not found (never fallback to wrong flagship device)
if (!matchedDevice) {
  matchedDevice = {
    id: slug || 'device',
    name: frontmatter.device || '스마트 디바이스',
    name_kr: frontmatter.device || '스마트 디바이스',
    brand: 'Tech',
    brand_kr: '테크',
    device_type: '스마트 디바이스',
    release_year: 2026,
    release_date: '2026',
    category: frontmatter.category || 'IT/테크',
    specs: {
      ap: '최신 고성능 프로세서',
      display: '고해상도 디스플레이',
      ram_storage: '대용량 RAM & 저장공간',
      camera: '고화질 카메라',
      battery: '대용량 배터리',
      dimensions_weight: '슬림 & 경량 디자인',
      os_durability: '최신 OS',
      price_krw: '출시가 기준'
    },
    videos: [
      {
        youtube_id: "F0kR0e2tZ48",
        title: `${frontmatter.device} 실사용 핸즈온 및 상세 리뷰`,
        channel: "Tech Insight",
        duration: "13:50",
        thumbnail: "https://img.youtube.com/vi/F0kR0e2tZ48/hqdefault.jpg",
        direct_watch_url: "https://www.youtube.com/watch?v=F0kR0e2tZ48"
      }
    ]
  };
}

const primaryVideo = (matchedDevice.videos && matchedDevice.videos.length > 0) 
  ? matchedDevice.videos[0] 
  : {
      youtube_id: "F0kR0e2tZ48",
      title: `${frontmatter.device} 실사용 핸즈온 및 디자인 분석`,
      channel: "Tech Review Studio",
      duration: "12:30",
      thumbnail: "https://img.youtube.com/vi/F0kR0e2tZ48/hqdefault.jpg"
    };

// Category-aware 4K tech visual fallback images
const getFallbackImage = (category?: string, devType?: string) => {
  if (category === 'Foldable' || (devType && devType.includes('폴더블'))) {
    return 'https://images.unsplash.com/photo-1580910051074-3eb694886505?w=800&auto=format&fit=crop&q=80';
  }
  if (category === '태블릿' || (devType && devType.includes('태블릿'))) {
    return 'https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=800&auto=format&fit=crop&q=80';
  }
  if (category === '오디오' || (devType && devType.includes('오디오'))) {
    return 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop&q=80';
  }
  if (category === 'PC/노트북' || (devType && devType.includes('PC'))) {
    return 'https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=800&auto=format&fit=crop&q=80';
  }
  return 'https://images.unsplash.com/photo-1598327105666-5b89351aff97?w=800&auto=format&fit=crop&q=80';
};

const defaultTechImage = getFallbackImage(matchedDevice?.category, matchedDevice?.device_type);
const heroThumbnail = `https://img.youtube.com/vi/${primaryVideo.youtube_id}/hqdefault.jpg`;
const fallbackThumbnail = defaultTechImage;

const jsonLd = {
  "@context": "https://schema.org/",
  "@type": "Review",
  "itemReviewed": {
    "@type": "Product",
    "name": frontmatter.device || frontmatter.title,
    "image": heroThumbnail
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": String(frontmatter.score || 9.0),
    "bestRating": "10"
  },
  "author": {
    "@type": "Organization",
    "name": "Tech Review Blog"
  }
};
---
<!DOCTYPE html>
<html lang={lang || 'ko'}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter.title} | TECH SPEC BLOG</title>
  <meta name="description" content={frontmatter.summary} />
  
  <!-- Open Graph / Social Media -->
  <meta property="og:type" content="article" />
  <meta property="og:title" content={`${frontmatter.title} | TECH SPEC BLOG`} />
  <meta property="og:description" content={frontmatter.summary} />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content={heroThumbnail} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${frontmatter.title} | TECH SPEC BLOG`} />
  <meta name="twitter:description" content={frontmatter.summary} />
  <meta name="twitter:image" content={heroThumbnail} />

  <!-- Global i18n SEO Hreflang Tags -->
  <link rel="alternate" hreflang="ko" href={koUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="ja" href={jaUrl} />
  <link rel="alternate" hreflang="x-default" href={koUrl} />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  <GoogleAnalytics />
  <GoogleAdSense />
</head>
<body>
  <Header />

  <main class="container" style="padding-top: 36px; padding-bottom: 80px;">
    <div class="review-layout-grid">
      <!-- Main Content (Left Column) -->
      <article class="review-article">
        <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
          <span class="badge">{frontmatter.category || '스마트폰/IT'}</span>
          {frontmatter.score >= 9.0 && (
            <span class="badge badge-gold">⭐ EDITORS CHOICE</span>
          )}
        </div>

        <h1>{frontmatter.title}</h1>
        
        <div class="review-meta">
          <span>📅 {frontmatter.date}</span>
          <span>•</span>
          <span>기기명: <strong style="color: var(--text-main); font-weight: 800;">{frontmatter.device}</strong></span>
          <span>•</span>
          <span>⏱️ 약 4분 심층 분석</span>
        </div>

        <!-- High-Resolution Device Hero Visual Banner -->
        <div class="device-hero-visual-card" style="margin-bottom: 24px; position: relative; border-radius: var(--radius-md); overflow: hidden; border: 1px solid var(--border-color); background: var(--bg-surface); box-shadow: 0 12px 32px rgba(0,0,0,0.5);">
          <div style="position: relative; width: 100%; aspect-ratio: 16/9; background: #000; overflow: hidden;">
            <img 
              src={heroThumbnail} 
              alt={`${frontmatter.device} 실물 핸즈온 및 디자인`} 
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease;"
              onerror={`this.onerror=null; this.src='${fallbackThumbnail}';`}
              loading="eager"
            />
            <div style="position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,14,22,0.1) 0%, rgba(10,14,22,0.85) 100%); pointer-events: none;"></div>
            
            <div style="position: absolute; top: 14px; left: 14px; display: flex; gap: 8px; z-index: 2;">
              <span style="background: rgba(0,0,0,0.75); backdrop-filter: blur(8px); color: var(--accent-cyan); font-size: 0.78rem; font-weight: 800; padding: 4px 10px; border-radius: 4px; border: 1px solid rgba(56,189,248,0.3);">
                📸 4K 실물 핸즈온 포토
              </span>
              <span style="background: rgba(0,0,0,0.75); backdrop-filter: blur(8px); color: #cbd5e1; font-size: 0.78rem; padding: 4px 10px; border-radius: 4px;">
                {primaryVideo.channel || 'Tech Editorial'}
              </span>
            </div>

            <!-- Play Video Overlay Button (Direct YouTube Link) -->
            <a 
              href={`https://www.youtube.com/watch?v=${primaryVideo.youtube_id}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-video-play-btn" 
              style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 68px; height: 68px; border-radius: 50%; background: rgba(225, 29, 72, 0.9); border: 2px solid #ffffff; color: #ffffff; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 0 28px rgba(225,29,72,0.6); z-index: 3; text-decoration: none;"
              aria-label="YouTube에서 기기 실사용 영상 직접 시청"
            >
              <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" style="margin-left: 3px;">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </a>

            <div style="position: absolute; bottom: 14px; left: 16px; right: 16px; z-index: 2; display: flex; justify-content: space-between; align-items: flex-end;">
              <div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">실물 디자인 및 구동 확인 (YouTube 공식 재생)</div>
                <div style="font-size: 1.05rem; font-weight: 700; color: #ffffff;">{primaryVideo.title}</div>
              </div>
              <a 
                href={`https://www.youtube.com/watch?v=${primaryVideo.youtube_id}`}
                target="_blank"
                rel="noopener noreferrer"
                style="background: #dc2626; color: #ffffff; font-size: 0.78rem; font-weight: 700; padding: 4px 10px; border-radius: 4px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;"
              >
                ▶ YouTube로 시청
              </a>
            </div>
          </div>
        </div>

        <!-- The Verge Style 'The Verdict' Box -->
        <div class="verdict-box">
          <div class="verdict-header">
            <div>
              <div style="font-size: 0.82rem; color: var(--accent-cyan); font-weight: 800; letter-spacing: 1px; text-transform: uppercase;">
                EDITORIAL VERDICT
              </div>
              <h3 class="verdict-title">
                {frontmatter.device} 에디터 최종 평결
              </h3>
            </div>
            <div class="verdict-score-display">
              <span class="verdict-score-num">{frontmatter.score || '9.0'}</span>
              <span class="verdict-score-total">/ 10</span>
            </div>
          </div>

          <div style="font-size: 0.95rem; color: #cbd5e1; line-height: 1.6; background: rgba(10, 14, 22, 0.5); padding: 14px 18px; border-radius: var(--radius-sm); border-left: 3px solid var(--accent-cyan); margin-bottom: 18px;">
            <strong style="color: var(--accent-cyan);">💡 The Bottom Line :</strong> {frontmatter.summary}
          </div>

          <div class="verdict-columns">
            <div class="verdict-col verdict-good">
              <h4>👍 The Good (주요 장점)</h4>
              <ul class="verdict-list">
                {frontmatter.pros && frontmatter.pros.map((pro: string) => (
                  <li>
                    <span style="color: #86efac; font-weight: bold;">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="verdict-col verdict-bad">
              <h4>👎 The Bad (아쉬운 점)</h4>
              <ul class="verdict-list">
                {frontmatter.cons && frontmatter.cons.map((con: string) => (
                  <li>
                    <span style="color: #fca5a5; font-weight: bold;">✕</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        <!-- Markdown Article Body with Specs and Benchmarks -->
        <slot />

        <!-- Interactive Hands-on Video & Photo Pool Section at bottom of review -->
        {matchedDevice?.videos && matchedDevice.videos.length > 0 && (
          <section class="review-video-pool-section" style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--border-color);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;">
              <div>
                <h3 style="font-size: 1.3rem; color: #ffffff; margin-bottom: 4px; display: flex; align-items: center; gap: 8px;">
                  🎬 {frontmatter.device} 실사용 핸즈온 영상 & 비주얼 풀
                </h3>
                <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
                  클릭 시 YouTube 앱/웹에서 고화질 공식 리뷰가 100% 바로 재생됩니다.
                </p>
              </div>
              <a href="/specs" class="badge" style="text-decoration: none; padding: 6px 12px; cursor: pointer;">
                전체 비디오 풀 ➔
              </a>
            </div>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px;">
              {matchedDevice.videos.map((vid: any) => (
                <a 
                  href={`https://www.youtube.com/watch?v=${vid.youtube_id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="video-card" 
                  style="text-decoration: none; display: block;"
                >
                  <div class="video-card-thumb-wrapper">
                    <img 
                      src={`https://img.youtube.com/vi/${vid.youtube_id}/hqdefault.jpg`} 
                      alt={vid.title} 
                      class="video-card-thumb" 
                      onerror={`this.onerror=null; this.src='${defaultTechImage}';`}
                      loading="lazy"
                    />
                    <div class="video-play-badge">▶</div>
                    <div class="video-duration-tag">{vid.duration}</div>
                  </div>
                  <div class="video-card-body">
                    <div class="video-card-title">{vid.title}</div>
                    <div class="video-card-channel">📺 {vid.channel} <span style="color: #ef4444; font-size: 0.75rem; margin-left: 4px; font-weight: 700;">▶ YouTube 시청</span></div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>

      <!-- Sticky Sidebar (Right Column for Desktop) -->
      <aside class="sidebar">
        <!-- Score Card Widget -->
        <div class="sidebar-card">
          <div class="sidebar-title">
            <span>📊 기기 프로필 & 평점</span>
          </div>
          
          <div style="margin-bottom: 14px; border-radius: 6px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08);">
            <img 
              src={`https://img.youtube.com/vi/${primaryVideo.youtube_id}/hqdefault.jpg`} 
              alt={frontmatter.device}
              onerror={`this.onerror=null; this.src='${defaultTechImage}';`}
              style="width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block;"
            />
          </div>

          <div class="score-badge-large">
            <div>
              <div style="font-size: 0.82rem; color: var(--text-muted);">에디터스 평점</div>
              <div style="font-size: 1.1rem; font-weight: 800; color: var(--text-main);">{frontmatter.device}</div>
            </div>
            <div class="score-num">{frontmatter.score}</div>
          </div>

          <div style="font-size: 0.85rem; color: var(--text-main); margin: 12px 0; line-height: 1.6; padding: 12px; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: var(--radius-sm);">
            <div>⚡ <strong>AP:</strong> {matchedDevice?.specs?.ap || '플래그십 프로세서'}</div>
            <div style="margin-top: 4px;">🖥️ <strong>화면:</strong> {matchedDevice?.specs?.display?.slice(0, 30) || '고해상도 패널'}...</div>
            <div style="margin-top: 4px;">💰 <strong>가격:</strong> {matchedDevice?.specs?.price_krw || '시세 기준'}</div>
          </div>

          <a href="/specs" class="btn-detail" style="display: block; text-align: center; text-decoration: none; margin-bottom: 12px; padding: 10px;">
            📚 전체 스펙 백과에서 비교하기 ➔
          </a>
        </div>

        <!-- Share Widget -->
        <div class="sidebar-card">
          <div class="sidebar-title">
            <span>🔗 리뷰 공유하기</span>
          </div>
          <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 16px;">
            이 기기 분석이 유용하셨다면 링크를 복사하여 공유해 보세요.
          </p>
          <button class="share-btn" id="copyUrlBtn">
            📋 현재 글 링크 복사
          </button>
        </div>

        <!-- Recent Reviews Widget -->
        {recentReviews.length > 0 && (
          <div class="sidebar-card">
            <div class="sidebar-title">
              <span>🔥 다른 최신 리뷰</span>
            </div>
            <div>
              {recentReviews.map((post: CollectionEntry<'reviews'>) => (
                <div class="recent-review-item">
                  <a href={`/reviews/${post.slug}`}>
                    {post.data.title}
                  </a>
                  <div class="recent-review-meta">
                    <span>{post.data.category || '테크'}</span>
                    <span style="color: var(--accent-cyan); font-weight: 700;">⭐ {post.data.score}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </aside>
    </div>
  </main>

  <!-- 16:9 Facade Video Player Modal for Reviews -->
  <div class="video-modal-backdrop" id="reviewVideoModal">
    <div class="video-modal-content">
      <div class="video-modal-header">
        <h4 class="video-modal-title" id="reviewVideoModalTitle">실사용 영상</h4>
        <button class="video-modal-close" onclick="closeReviewVideoPlayer()">✕</button>
      </div>
      <div class="video-player-frame-wrapper" id="reviewVideoFrameContainer"></div>
    </div>
  </div>

  <footer>
    <div class="container">
      <div style="margin-bottom: 12px; display: flex; justify-content: center; gap: 20px; font-size: 0.9rem;">
        <a href="/about" style="color: var(--text-muted); text-decoration: none;">블로그 소개</a>
        <a href="/privacy" style="color: var(--text-muted); text-decoration: none;">개인정보처리방침</a>
        <a href="/contact" style="color: var(--text-muted); text-decoration: none;">문의하기</a>
      </div>
      <p>© 2026 Tech Review Blog. Professional Tech Editorial Magazine & Spec Database.</p>
    </div>
  </footer>

  <Analytics />

  <script is:inline>
    // Copy URL
    const btn = document.getElementById('copyUrlBtn');
    if (btn) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href).then(() => {
          const originalText = btn.innerText;
          btn.innerText = '✅ 링크 복사 완료!';
          setTimeout(() => {
            btn.innerText = originalText;
          }, 2000);
        });
      });
    }

    // Video Player Facade Modal
    window.playReviewVideo = function(videoId, videoTitle) {
      const modal = document.getElementById('reviewVideoModal');
      const titleElem = document.getElementById('reviewVideoModalTitle');
      const container = document.getElementById('reviewVideoFrameContainer');

      if (!modal || !container) return;

      if (titleElem) titleElem.innerText = videoTitle || '기기 실사용 영상';
      const searchUrl = `https://www.youtube.com/results?search_query=${encodeURIComponent(videoTitle || '테크 기기 실사용 리뷰')}`;
      const directWatchUrl = videoId ? `https://www.youtube.com/watch?v=${videoId}` : searchUrl;

      container.innerHTML = `
        <div style="margin-bottom: 12px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px; background: rgba(220,38,38,0.15); border: 1px solid rgba(220,38,38,0.4); padding: 10px 14px; border-radius: 6px;">
          <span style="font-size: 0.85rem; color: #fca5a5;">
            🎬 외부 임베드 제한 시 원클릭으로 YouTube에서 이 영상을 고화질로 바로 시청하세요:
          </span>
          <a href="${directWatchUrl}" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 6px; background: #dc2626; color: #ffffff; padding: 7px 16px; border-radius: 4px; font-size: 0.85rem; font-weight: 700; text-decoration: none; box-shadow: 0 2px 8px rgba(220,38,38,0.4);">
            ▶ YouTube에서 원본 영상 바로보기 ➔
          </a>
        </div>
        <div style="position: relative; width: 100%; aspect-ratio: 16/9; background: #000; border-radius: 8px; overflow: hidden;">
          <iframe 
            src="https://www.youtube.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0&enablejsapi=1" 
            title="${videoTitle || 'YouTube video'}" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;"
          >
          </iframe>
        </div>
        <div style="margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid rgba(255,255,255,0.1);">
          <span style="font-size: 0.82rem; color: var(--text-muted);">
            📺 기기별 핸즈온 & 벤치마크 영상 풀
          </span>
          <div style="display: flex; gap: 8px;">
            <a href="${directWatchUrl}" target="_blank" rel="noopener noreferrer" style="background: #dc2626; color: #ffffff; padding: 6px 14px; border-radius: 4px; font-size: 0.82rem; font-weight: 700; text-decoration: none;">
              ▶ 원본 영상 직접 시청
            </a>
            <a href="${searchUrl}" target="_blank" rel="noopener noreferrer" style="background: rgba(255,255,255,0.1); color: #e2e8f0; padding: 6px 14px; border-radius: 4px; font-size: 0.82rem; text-decoration: none; border: 1px solid rgba(255,255,255,0.2);">
              🔍 다른 리뷰 영상 더보기
            </a>
          </div>
        </div>
      `;

      modal.classList.add('active');
    };

    window.closeReviewVideoPlayer = function() {
      const modal = document.getElementById('reviewVideoModal');
      const container = document.getElementById('reviewVideoFrameContainer');
      if (!modal || !container) return;

      modal.classList.remove('active');
      container.innerHTML = ''; // Stop audio & remove iframe
    };

    // Close on backdrop click
    document.getElementById('reviewVideoModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'reviewVideoModal') {
        window.closeReviewVideoPlayer();
      }
    });

    // Close on ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.closeReviewVideoPlayer();
      }
    });
  </script>
</body>
</html>
