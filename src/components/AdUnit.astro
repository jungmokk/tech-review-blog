---
// src/components/AdUnit.astro
// Reusable Google AdSense Ad Unit Component with CLS prevention

interface Props {
  slotId?: string;
  format?: 'auto' | 'rectangle' | 'vertical' | 'horizontal';
  responsive?: boolean;
  style?: string;
  className?: string;
  label?: string;
  minHeight?: string;
}

const {
  slotId = '',
  format = 'auto',
  responsive = true,
  style = 'display:block;',
  className = '',
  label = 'ADVERTISEMENT',
  minHeight = '280px'
} = Astro.props;

const adsenseId = import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-5136549253813943';
---

<div class={`adsense-wrapper ${className}`} style={`min-height: ${minHeight}; position: relative; margin: 18px 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(15, 23, 42, 0.4); border: 1px dashed rgba(255, 255, 255, 0.08); border-radius: var(--radius-sm, 8px); overflow: hidden;`}>
  <div style="font-size: 0.65rem; color: #64748b; letter-spacing: 1.5px; text-transform: uppercase; margin-bottom: 6px; padding-top: 6px; font-weight: 700; width: 100%; text-align: center;">
    {label}
  </div>

  <ins class="adsbygoogle"
       style={style}
       data-ad-client={adsenseId}
       {...(slotId ? { 'data-ad-slot': slotId } : {})}
       data-ad-format={format}
       data-full-width-responsive={responsive ? "true" : "false"}></ins>

  <script is:inline>
    (function() {
      try {
        if (typeof window !== 'undefined' && (window.location.hostname.includes('thesinoreport.com') || !window.location.hostname.includes('localhost'))) {
          (window.adsbygoogle = window.adsbygoogle || []).push({});
        }
      } catch (e) {
        console.warn('AdSense slot init info:', e);
      }
    })();
  </script>
</div>
